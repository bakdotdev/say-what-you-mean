{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/say-what-you-mean", "destination": "/say-what-you-mean/index.html" },
    { "source": "/say-what-you-mean/", "destination": "/say-what-you-mean/index.html" },
    { "source": "/say-what-you-mean/:path*", "destination": "/say-what-you-mean/index.html" }
  ]
}
