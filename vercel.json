{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/say-what-you-mean/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/say-what-you-mean/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/say-what-you-mean/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/say-what-you-mean/wordlist.txt",
      "destination": "/wordlist.txt"
    },
    {
      "source": "/say-what-you-mean",
      "destination": "/index.html"
    },
    {
      "source": "/say-what-you-mean/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "interest-cohort=(), browsing-topics=()"
        }
      ]
    }
  ]
}
